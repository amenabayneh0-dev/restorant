# PUBLIC (safe in the browser) — Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# SERVER-ONLY (never prefix with NEXT_PUBLIC_, never commit) — used only to call create_order / get_order_tracking
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY

# SERVER-ONLY: 32+ random chars. Generate with: openssl rand -base64 48
TRACKING_TOKEN_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
