# ---- Add these 4 in Vercel > Project > Settings > Environment Variables (and in .env.local for local dev) ----

# PUBLIC (safe in the browser). Supabase > Project Settings > API. Must be the project URL ONLY, no /rest/v1 on the end.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "publishable" key (sb_publishable_...). On older projects this is the "anon" key; the app accepts that too
# if you name it NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# SERVER-ONLY SECRET. Never prefix with NEXT_PUBLIC_, never commit, never paste in chat.
# The "secret" key (sb_secret_...). On older projects this is the "service_role" key; the app accepts that too
# if you name it SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY

# SERVER-ONLY: 32+ random characters. Generate with: openssl rand -base64 48
TRACKING_TOKEN_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
