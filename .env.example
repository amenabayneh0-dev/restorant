# ===== Add these in Vercel > Project > Settings > Environment Variables (and .env.local for local dev) =====
# Never commit real values. Never paste keys into chats.

# --- Supabase API (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co        # URL only, no /rest/v1
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY            # older projects: the "anon" key, named NEXT_PUBLIC_SUPABASE_ANON_KEY
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY                                  # SERVER ONLY, mark Sensitive. Older projects: "service_role", named SUPABASE_SERVICE_ROLE_KEY

# --- Security ---
TRACKING_TOKEN_SECRET=CHANGE_ME_32_PLUS_RANDOM_CHARS                 # openssl rand -base64 48

# --- Automatic setup on every deploy (migrations, image bucket, first admin login) ---
# Supabase dashboard > Connect > "Session pooler" URI (IPv4, works on Vercel). Replace [YOUR-PASSWORD].
SUPABASE_DB_URL=postgresql://postgres.YOURREF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
ADMIN_EMAIL=owner@yourrestaurant.com                                 # created once; password is NOT changed on later deploys
ADMIN_PASSWORD=AT_LEAST_10_CHARACTERS

# --- Optional ---
SEED_DEMO_MENU=false                                                 # true = load the fictional demo menu (use for a first look, never for the real launch)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com                          # for sitemap/OG tags; Vercel's own URL is used if empty
